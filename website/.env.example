# Optional overrides. By default the site links to GitHub's latest release
# (releases/latest/download/HashFleet-macos-arm64.zip etc.), so no rebuild is needed per release.
# Every VITE_ value is public and baked into the browser build. Never put secrets here.
# Put overrides in .env.local, which is ignored by Git, then rebuild.
VITE_MAC_DOWNLOAD_URL=
VITE_CLI_DOWNLOAD_URL=
VITE_IOS_DOWNLOAD_URL=
VITE_SOURCE_URL=
